# ───────────── Copiá este archivo como ".env" y completá los valores ─────────────
# Guía paso a paso: docs/SUPABASE.md

# "development" mientras probás en tu computadora. Poné "production" en el servidor real.
NODE_ENV=development

# Puerto donde corre el servidor
PORT=3000

# ───────────── Supabase (base de datos, Auth y Storage) ─────────────
# Panel de Supabase → Project Settings → API  (o "Data API" + "API Keys")
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave PÚBLICA (anon / publishable). Es la misma que va en client/.env.
SUPABASE_ANON_KEY=
# Clave PRIVADA (service_role / secret). Saltea RLS: SÓLO en este archivo del servidor.
# Nunca la pongas en client/.env ni la subas a Git.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage para las imágenes (lo crea la migración)
SUPABASE_BUCKET=portfolio

# Dirección pública del sitio, sin barra al final (se usa en los links de los correos).
# En desarrollo: http://localhost:5173   En producción: la dirección real, con https
PUBLIC_URL=http://localhost:5173

# Poné true si el servidor está detrás de un proxy (Render, nginx, Cloudflare...)
TRUST_PROXY=false

# ───────────── Datos del portfolio ─────────────
SITIO_NOMBRE=Nicolás Herrera
# Zona horaria para agrupar las métricas por día
ZONA_HORARIA=America/Argentina/Salta
# Opcional: secreto para el hash diario de visitantes (si falta se deriva de la service_role)
VISITAS_SECRET=

# ───────────── Login con Google ─────────────
# 1. Activá el proveedor Google en Supabase → Authentication → Providers (ver docs/SUPABASE.md)
# 2. Poné true para que el sitio muestre el botón "Continuar con Google"
GOOGLE_HABILITADO=false

# ───────────── Correo (formulario de contacto y respuestas) ─────────────
# Si SMTP_HOST está vacío el sitio funciona igual, pero los correos NO se envían: se "simulan"
# (quedan guardados y se avisa en el panel). Para la demo con el profesor configurá uno real.
#
# Gmail: activá la verificación en 2 pasos y creá una "contraseña de aplicación":
#   https://myaccount.google.com/apppasswords   (SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true)
# Brevo (gratis, 300/día): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false
# Probar la conexión:  npm run correo:probar --prefix server
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Quién figura como remitente (con Gmail tiene que ser la misma cuenta de SMTP_USER)
CORREO_REMITENTE="Nicolás Herrera <no-reply@example.com>"
# A qué casilla llegan los avisos de consultas nuevas (la del dueño del portfolio)
CORREO_DESTINO=
# A qué casilla llegan las respuestas del visitante cuando contesta un correo (opcional)
CORREO_RESPONDER_A=

# ───────────── APIs externas ─────────────
# Usuario de GitHub cuyos repositorios se muestran en la sección de actividad (si queda vacío, la sección no aparece)
GITHUB_USUARIO=
# Opcional: token de GitHub (sin permisos) para subir el límite de consultas de 60 a 5000 por hora
GITHUB_TOKEN=
# Ciudad y coordenadas para el widget de hora y clima (Open-Meteo, no pide clave)
CLIMA_CIUDAD=Salta, Argentina
CLIMA_LATITUD=-24.7821
CLIMA_LONGITUD=-65.4232
