# Servicio de systemd: arranca el portfolio con el servidor, lo reinicia si se cae y guarda el registro.
# Copiar a /etc/systemd/system/portfolio.service (ver docs/PUBLICAR.md).
[Unit]
Description=Portfolio fullstack (Node.js + Supabase)
After=network-online.target
Wants=network-online.target

[Service]
User=portfolio
WorkingDirectory=/home/portfolio/app/server
ExecStart=/usr/bin/node src/index.js
Environment=NODE_ENV=production
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
